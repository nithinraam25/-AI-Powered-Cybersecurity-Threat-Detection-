# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# SQLite & local databases
*.db
*.sqlite
*.sqlite3

# Data files (Datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (Weights, checkpoints, serialized models)
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pickle
*.h5
*.onnx

# Generated outputs & logs
outputs/reports/*
!outputs/reports/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep
*.log

# Pytest / coverage cache
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE / Editor configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
