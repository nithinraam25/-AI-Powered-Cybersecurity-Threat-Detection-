# ==========================================
# Environment Configuration Template
# COPY TO .env BEFORE RUNNING IN PRODUCTION
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS
# ==========================================

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Storage & Database
SQLITE_DB_PATH=outputs/threat_events.db

# Model & Pipeline Configuration
MODEL_DIR=models
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
RANDOM_SEED=42

# Threat Scoring Thresholds
THREAT_SCORE_CRITICAL=85.0
THREAT_SCORE_HIGH=70.0
THREAT_SCORE_MEDIUM=45.0
THREAT_SCORE_LOW=20.0
